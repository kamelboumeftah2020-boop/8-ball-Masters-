rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each learner can read and write only their own progress document.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Weekly leaderboard: any signed-in learner can read it; each learner
    // writes only their own row, with a name and a sensible XP value.
    match /leaderboards/{week}/entries/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'xp', 'level', 'streak'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 20000
        && request.resource.data.level is string && request.resource.data.level.size() <= 4
        && request.resource.data.streak is int && request.resource.data.streak >= 0;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Crash reports: signed-in learners can send one about their own app;
    // only you can read them (in the Firebase console).
    match /crashes/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['time', 'version', 'device', 'android', 'trace', 'uid'])
        && request.resource.data.trace is string && request.resource.data.trace.size() <= 10000;
    }
  }
}
