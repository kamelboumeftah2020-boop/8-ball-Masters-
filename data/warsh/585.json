{"j":30,"b":[["h",80],["b"],["t",13,[[80,1,"عَبَسَ وَتَوَلّ۪ىٰٓ ١",1],[80,2,"أَن جَآءَهُ اُ۬لَاعْم۪ىٰۖ ٢",1],[80,3,"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكّ۪ىٰٓ ٣",1],[80,4,"أَوْ يَذَّكَّرُ فَتَنفَعُهُ اُ۬لذِّكْر۪ىٰٓۖ ٤",1],[80,5,"أَمَّا مَنِ اِ۪سْتَغْن۪ىٰ ٥",1],[80,6,"فَأَنتَ لَهُۥ تَصَّدّ۪ىٰ ٦",1],[80,7,"وَمَا عَلَيْكَ أَلَّا يَزَّكّ۪ىٰۖ ٧",1],[80,8,"وَأَمَّا مَن جَآءَكَ يَسْع۪ىٰ ٨",1],[80,9,"وَهُوَ يَخْش۪ىٰ ٩",1],[80,10,"فَأَنتَ عَنْهُ تَلَهّ۪ىٰ ١٠",1],[80,11,"كَلَّآۖ إِنَّهَا تَذْكِرَةٞۖ ١١",1],[80,12,"فَمَن شَآءَ ذَكَرَهُۥ ١٢",1],[80,13,"فِے صُحُفٖ مُّكَرَّمَةٖ ١٣",1],[80,14,"مَّرْفُوعَةٖ مُّطَهَّرَةِۢ ١٤",1],[80,15,"بِأَيْدِے سَفَرَةٖ ١٥",1],[80,16,"كِرَامِۢ بَرَرَةٖۖ ١٦",1],[80,17,"قُتِلَ اَ۬لِانسَٰنُ مَآ أَكْفَرَهُۥۖ ١٧",1],[80,18,"مِنَ اَيِّ شَےْءٍ خَلَقَهُۥۖ ١٨",1],[80,19,"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ ١٩",1],[80,20,"ثُمَّ اَ۬لسَّبِيلَ يَسَّرَهُۥ ٢٠",1],[80,21,"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥۖ ٢١",1],[80,22,"ثُمَّ إِذَا شَآءَ انشَرَهُۥۖ ٢٢",1],[80,23,"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥۖ ٢٣",1],[80,24,"فَلْيَنظُرِ اِ۬لِانسَٰنُ إِلَىٰ طَعَامِهِۦٓۖ ٢٤",1],[80,25,"إِنَّا صَبَبْنَا اَ۬لْمَآءَ صَبّاٗ ٢٥",1],[80,26,"ثُمَّ شَقَقْنَا اَ۬لَارْضَ شَقّاٗ ٢٦",1],[80,27,"فَأَنۢبَتْنَا فِيهَا حَبّاٗ ٢٧",1],[80,28,"وَعِنَباٗ وَقَضْباٗ ٢٨",1],[80,29,"وَزَيْتُوناٗ وَنَخْلاٗ ٢٩",1],[80,30,"وَحَدَآئِقَ غُلْباٗ ٣٠",1],[80,31,"وَفَٰكِهَةٗ وَأَبّاٗ ٣١",1],[80,32,"مَّتَٰعاٗ لَّكُمْ وَلِأَنْعَٰمِكُمْۖ ٣٢",1],[80,33,"فَإِذَا جَآءَتِ اِ۬لصَّآخَّةُ ٣٣",1],[80,34,"يَوْمَ يَفِرُّ اُ۬لْمَرْءُ مِنَ اَخِيهِ ٣٤",1],[80,35,"وَأُمِّهِۦ وَأَبِيهِ ٣٥",1],[80,36,"وَصَٰحِبَتِهِۦ وَبَنِيهِۖ ٣٦",1],[80,37,"لِكُلِّ اِ۪مْرِےٕٖ مِّنْهُمْ يَوْمَئِذٖ شَأْنٞ يُغْنِيهِۖ ٣٧",1],[80,38,"وُجُوهٞ يَوْمَئِذٖ مُّسْفِرَةٞ ٣٨",1],[80,39,"ضَاحِكَةٞ مُّسْتَبْشِرَةٞۖ ٣٩",1],[80,40,"وَوُجُوهٞ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٞ ٤٠",1]]]]}