{"j":30,"b":[["t",1,[[80,41,"تَرْهَقُهَا قَتَرَةٌۖ ٤١",1],[80,42,"ا۟وْلَٰٓئِكَ هُمُ اُ۬لْكَفَرَةُ اُ۬لْفَجَرَةُۖ ٤٢",1]]],["h",81],["b"],["t",12,[[81,1,"إِذَا اَ۬لشَّمْسُ كُوِّرَتْ ١",1],[81,2,"وَإِذَا اَ۬لنُّجُومُ اُ۪نكَدَرَتْ ٢",1],[81,3,"وَإِذَا اَ۬لْجِبَالُ سُيِّرَتْ ٣",1],[81,4,"وَإِذَا اَ۬لْعِشَارُ عُطِّلَتْ ٤",1],[81,5,"وَإِذَا اَ۬لْوُحُوشُ حُشِرَتْ ٥",1],[81,6,"وَإِذَا اَ۬لْبِحَارُ سُجِّرَتْ ٦",1],[81,7,"وَإِذَا اَ۬لنُّفُوسُ زُوِّجَتْ ٧",1],[81,8,"وَإِذَا اَ۬لْمَوْءُۥدَةُ سُئِلَتْ ٨",1],[81,9,"بِأَيِّ ذَنۢبٖ قُتِلَتْ ٩",1],[81,10,"وَإِذَا اَ۬لصُّحُفُ نُشِرَتْ ١٠",1],[81,11,"وَإِذَا اَ۬لسَّمَآءُ كُشِطَتْ ١١",1],[81,12,"وَإِذَا اَ۬لْجَحِيمُ سُعِّرَتْ ١٢",1],[81,13,"وَإِذَا اَ۬لْجَنَّةُ أُزْلِفَتْ ١٣",1],[81,14,"عَلِمَتْ نَفْسٞ مَّآ أَحْضَرَتْۖ ١٤",1],[81,15,"فَلَآ أُقْسِمُ بِالْخُنَّسِ ١٥",1],[81,16,"اِ۬لْجَوَارِ اِ۬لْكُنَّسِ ١٦",1],[81,17,"وَاليْلِ إِذَا عَسْعَسَ ١٧",1],[81,18,"وَالصُّبْحِ إِذَا تَنَفَّسَ ١٨",1],[81,19,"إِنَّهُۥ لَقَوْلُ رَسُولٖ كَرِيمٖ ١٩",1],[81,20,"ذِے قُوَّةٍ عِندَ ذِے اِ۬لْعَرْشِ مَكِينٖ ٢٠",1],[81,21,"مُّطَاعٖ ثَمَّ أَمِينٖۖ ٢١",1],[81,22,"وَمَا صَٰحِبُكُم بِمَجْنُونٖۖ ٢٢",1],[81,23,"وَلَقَدْ ر۪ء۪اهُ بِالُافُقِ اِ۬لْمُبِينِۖ ٢٣",1],[81,24,"وَمَا هُوَ عَلَى اَ۬لْغَيْبِ بِضَنِينٖۖ ٢٤",1],[81,25,"وَمَا هُوَ بِقَوْلِ شَيْطَٰنٖ رَّجِيمٖ ٢٥",1],[81,26,"فَأَيْنَ تَذْهَبُونَۖ ٢٦",1],[81,27,"إِنْ هُوَ إِلَّا ذِكْرٞ لِّلْعَٰلَمِينَ ٢٧",1],[81,28,"لِمَن شَآءَ مِنكُمُۥٓ أَنْ يَّسْتَقِيمَۖ ٢٨",1],[81,29,"وَمَا تَشَآءُونَ إِلَّآ أَنْ يَّشَآءَ اَ۬للَّهُ رَبُّ اُ۬لْعَٰلَمِينَۖ ٢٩",1]]]]}