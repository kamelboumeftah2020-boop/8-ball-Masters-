{"j":30,"b":[["t",5,[[92,10,"فَسَنُيَسِّرُهُۥ لِلْعُسْر۪ىٰۖ ١٠",1],[92,11,"وَمَا يُغْنِے عَنْهُ مَالُهُۥٓ إِذَا تَرَدّ۪ىٰٓۖ ١١",1],[92,12,"إِنَّ عَلَيْنَا لَلْهُد۪ىٰ ١٢",1],[92,13,"وَإِنَّ لَنَا لَلَاخِرَةَ وَالُاول۪ىٰۖ ١٣",1],[92,14,"فَأَنذَرْتُكُمْ نَاراٗ تَلَظّ۪ىٰ ١٤",1],[92,15,"لَا يَصْلَيٰهَآ إِلَّا اَ۬لَاشْقَي ١٥",1],[92,16,"اَ۬لذِے كَذَّبَ وَتَوَلّ۪ىٰۖ ١٦",1],[92,17,"وَسَيُجَنَّبُهَا اَ۬لَاتْقَي ١٧",1],[92,18,"اَ۬لذِے يُوتِے مَالَهُۥ يَتَزَكّ۪ىٰۖ ١٨",1],[92,19,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٖ تُجْز۪ىٰٓ ١٩",1],[92,20,"إِلَّا اَ۪بْتِغَآءَ وَجْهِ رَبِّهِ اِ۬لَاعْل۪ىٰۖ ٢٠",1],[92,21,"وَلَسَوْفَ يَرْض۪ىٰۖ ٢١",1]]],["h",93],["b"],["t",5,[[93,1,"وَالضُّح۪ىٰ ١",1],[93,2,"وَاليْلِ إِذَا سَج۪ىٰ ٢",1],[93,3,"مَا وَدَّعَكَ رَبُّكَ وَمَا قَل۪ىٰۖ ٣",1],[93,4,"وَلَلَاخِرَةُ خَيْرٞ لَّكَ مِنَ اَ۬لُاول۪ىٰۖ ٤",1],[93,5,"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْض۪ىٰٓۖ ٥",1],[93,6,"أَلَمْ يَجِدْكَ يَتِيماٗ فَـَٔاو۪ىٰ ٦",1],[93,7,"وَوَجَدَكَ ضَآلّاٗ فَهَد۪ىٰ ٧",1],[93,8,"وَوَجَدَكَ عَآئِلاٗ فَأَغْن۪ىٰۖ ٨",1],[93,9,"فَأَمَّا اَ۬لْيَتِيمَ فَلَا تَقْهَرْۖ ٩",1],[93,10,"وَأَمَّا اَ۬لسَّآئِلَ فَلَا تَنْهَرْۖ ١٠",1],[93,11,"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثَۖ ١١",1]]],["h",94],["b"],["t",1,[[94,1,"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ١",1],[94,2,"وَوَضَعْنَا عَنكَ وِزْرَكَ ٢",1]]]]}