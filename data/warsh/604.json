{"j":30,"b":[["h",112],["b"],["t",2,[[112,1,"قُلْ هُوَ اَ۬للَّهُ أَحَدٌۖ ١",1],[112,2,"اِ۬للَّهُ اُ۬لصَّمَدُۖ ٢",1],[112,3,"لَمْ يَلِدْ وَلَمْ يُولَدْۖ ٣",1],[112,4,"وَلَمْ يَكُن لَّهُۥ كُفُؤاً اَحَدٞۖ ٤",1]]],["h",113],["b"],["t",3,[[113,1,"قُلَ اَعُوذُ بِرَبِّ اِ۬لْفَلَقِ ١",1],[113,2,"مِن شَرِّ مَا خَلَقَ ٢",1],[113,3,"وَمِن شَرِّ غَاسِقٍ اِذَا وَقَبَ ٣",1],[113,4,"وَمِن شَرِّ اِ۬لنَّفَّٰثَٰتِ فِے اِ۬لْعُقَدِ ٤",1],[113,5,"وَمِن شَرِّ حَاسِدٍ اِذَا حَسَدَۖ ٥",1]]],["h",114],["b"],["t",4,[[114,1,"قُلَ اَعُوذُ بِرَبِّ اِ۬لنَّاسِ ١",1],[114,2,"مَلِكِ اِ۬لنَّاسِ ٢",1],[114,3,"إِلَٰهِ اِ۬لنَّاسِ ٣",1],[114,4,"مِن شَرِّ اِ۬لْوَسْوَاسِ اِ۬لْخَنَّاسِ ٤",1],[114,5,"اِ۬لذِے يُوَسْوِسُ فِے صُدُورِ اِ۬لنَّاسِ ٥",1],[114,6,"مِنَ اَ۬لْجِنَّةِ وَالنَّاسِۖ ٦",1]]]]}