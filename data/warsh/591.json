{"j":30,"b":[["h",86],["b"],["t",7,[[86,1,"وَالسَّمَآءِ وَالطَّارِقِ ١",1],[86,2,"وَمَآ أَدْر۪يٰكَ مَا اَ۬لطَّارِقُ ٢",1],[86,3,"اُ۬لنَّجْمُ اُ۬لثَّاقِبُ ٣",1],[86,4,"إِن كُلُّ نَفْسٖ لَّمَا عَلَيْهَا حَافِظٞۖ ٤",1],[86,5,"فَلْيَنظُرِ اِ۬لِانسَٰنُ مِمَّ خُلِقَۖ ٥",1],[86,6,"خُلِقَ مِن مَّآءٖ دَافِقٖ ٦",1],[86,7,"يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ ٧",1],[86,8,"إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٞ ٨",1],[86,9,"يَوْمَ تُبْلَى اَ۬لسَّرَآئِرُ ٩",1],[86,10,"فَمَا لَهُۥ مِن قُوَّةٖ وَلَا نَاصِرٖۖ ١٠",1],[86,11,"وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ ١١",1],[86,12,"وَالَارْضِ ذَاتِ اِ۬لصَّدْعِ ١٢",1],[86,13,"إِنَّهُۥ لَقَوْلٞ فَصْلٞ ١٣",1],[86,14,"وَمَا هُوَ بِالْهَزْلِۖ ١٤",1],[86,15,"إِنَّهُمْ يَكِيدُونَ كَيْداٗ ١٥",1],[86,16,"وَأَكِيدُ كَيْداٗۖ ١٦",1],[86,17,"فَمَهِّلِ اِ۬لْكٰ۪فِرِينَ أَمْهِلْهُمْ رُوَيْداٗۖ ١٧",1]]],["h",87],["b"],["t",4,[[87,1,"سَبِّحِ اِ۪سْمَ رَبِّكَ اَ۬لَاعْلَي ١",1],[87,2,"اَ۬لذِے خَلَقَ فَسَوّ۪ىٰ ٢",1],[87,3,"وَالذِے قَدَّرَ فَهَد۪ىٰ ٣",1],[87,4,"وَالذِےٓ أَخْرَجَ اَ۬لْمَرْع۪ىٰ ٤",1],[87,5,"فَجَعَلَهُۥ غُثَآءً اَحْو۪ىٰۖ ٥",1],[87,6,"سَنُقْرِئُكَ فَلَا تَنس۪ىٰٓ ٦",1],[87,7,"إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْف۪ىٰۖ ٧",1],[87,8,"وَنُيَسِّرُكَ لِلْيُسْر۪ىٰۖ ٨",1],[87,9,"فَذَكِّرِ اِن نَّفَعَتِ اِ۬لذِّكْر۪ىٰۖ ٩",1],[87,10,"سَيَذَّكَّرُ مَنْ يَّخْش۪ىٰ ١٠",1]]]]}