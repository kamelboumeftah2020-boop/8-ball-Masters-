{"j":30,"b":[["t",3,[[100,6,"اِنَّ اَ۬لِانسَٰنَ لِرَبِّهِۦ لَكَنُودٞ ٦",1],[100,7,"وَإِنَّهُۥ عَلَىٰ ذَٰلِكَ لَشَهِيدٞ ٧",1],[100,8,"وَإِنَّهُۥ لِحُبِّ اِ۬لْخَيْرِ لَشَدِيدٌۖ ٨",1],[100,9,"۞ اَفَلَا يَعْلَمُ إِذَا بُعْثِرَ مَا فِے اِ۬لْقُبُورِ ٩",1],[100,10,"وَحُصِّلَ مَا فِے اِ۬لصُّدُورِ ١٠",1],[100,11,"إِنَّ رَبَّهُم بِهِمْ يَوْمَئِذٖ لَّخَبِيرٌۖ ١١",1]]],["h",101],["b"],["t",5,[[101,1,"اِ۬لْقَارِعَةُ مَا اَ۬لْقَارِعَةُۖ ١",1],[101,2,"وَمَآ أَدْر۪يٰكَ مَا اَ۬لْقَارِعَةُۖ ٢",1],[101,3,"يَوْمَ يَكُونُ اُ۬لنَّاسُ كَالْفَرَاشِ اِ۬لْمَبْثُوثِ ٣",1],[101,4,"وَتَكُونُ اُ۬لْجِبَالُ كَالْعِهْنِ اِ۬لْمَنفُوشِۖ ٤",1],[101,5,"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ ٥",1],[101,6,"فَهُوَ فِے عِيشَةٖ رَّاضِيَةٖۖ ٦",1],[101,7,"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ ٧",1],[101,8,"فَأُمُّهُۥ هَاوِيَةٞۖ ٨",1],[101,9,"وَمَآ أَدْر۪يٰكَ مَا هِيَهْۖ ٩",1],[101,10,"نَارٌ حَامِيَةٌۖ ١٠",1]]],["h",102],["b"],["t",3,[[102,1,"اَلْه۪يٰكُمُ اُ۬لتَّكَاثُرُ ١",1],[102,2,"حَتَّىٰ زُرْتُمُ اُ۬لْمَقَابِرَۖ ٢",1],[102,3,"كَلَّا سَوْفَ تَعْلَمُونَ ٣",1],[102,4,"ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۖ ٤",1],[102,5,"كَلَّا لَوْ تَعْلَمُونَ عِلْمَ اَ۬لْيَقِينِۖ ٥",1],[102,6,"لَتَرَوُنَّ اَ۬لْجَحِيمَ ٦",1],[102,7,"ثُمَّ لَتَرَوُنَّهَا عَيْنَ اَ۬لْيَقِينِ ٧",1],[102,8,"ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ اِ۬لنَّعِيمِۖ ٨",1]]]]}