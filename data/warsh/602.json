{"j":30,"b":[["h",106],["b"],["t",3,[[106,1,"لِّإِيلَٰفِ قُرَيْشٍ ١",1],[106,2,"اِيلَٰفِهِمْ رِحْلَةَ اَ۬لشِّتَآءِ وَالصَّيْفِۖ ٢",1],[106,3,"فَلْيَعْبُدُواْ رَبَّ هَٰذَا اَ۬لْبَيْتِ ٣",1],[106,4,"اِ۬لذِےٓ أَطْعَمَهُم مِّن جُوعٖ ٤",1],[106,5,"وَءَامَنَهُم مِّنْ خَوْفٍۖ ٥",1]]],["h",107],["b"],["t",4,[[107,1,"اَرَٰٓيْتَ اَ۬لذِے يُكَذِّبُ بِالدِّينِ ١",1],[107,2,"فَذَٰلِكَ اَ۬لذِے يَدُعُّ اُ۬لْيَتِيمَ ٢",1],[107,3,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ اِ۬لْمِسْكِينِۖ ٣",1],[107,4,"فَوَيْلٞ لِّلْمُصَلِّينَ ٤",1],[107,5,"اَ۬لذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ ٥",1],[107,6,"اَ۬لذِينَ هُمْ يُرَآءُونَ وَيَمْنَعُونَ اَ۬لْمَاعُونَۖ ٦",1]]],["h",108],["b"],["t",2,[[108,1,"إِنَّآ أَعْطَيْنَٰكَ اَ۬لْكَوْثَرَ ١",1],[108,2,"فَصَلِّ لِرَبِّكَ وَانْحَرِۖ ٢",1],[108,3,"اِنَّ شَانِئَكَ هُوَ اَ۬لَابْتَرُۖ ٣",1]]]]}