[[6024,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ لَآ أُقْسِمُ بِهَٰذَا ٱلْبَلَدِ",594,30,0],[6025,2,"وَأَنتَ حِلٌّۢ بِهَٰذَا ٱلْبَلَدِ",594,30,0],[6026,3,"وَوَالِدٍۢ وَمَا وَلَدَ",594,30,0],[6027,4,"لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِى كَبَدٍ",594,30,0],[6028,5,"أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌۭ",594,30,0],[6029,6,"يَقُولُ أَهْلَكْتُ مَالًۭا لُّبَدًا",594,30,0],[6030,7,"أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",594,30,0],[6031,8,"أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",594,30,0],[6032,9,"وَلِسَانًۭا وَشَفَتَيْنِ",594,30,0],[6033,10,"وَهَدَيْنَٰهُ ٱلنَّجْدَيْنِ",594,30,0],[6034,11,"فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",594,30,0],[6035,12,"وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",594,30,0],[6036,13,"فَكُّ رَقَبَةٍ",594,30,0],[6037,14,"أَوْ إِطْعَٰمٌۭ فِى يَوْمٍۢ ذِى مَسْغَبَةٍۢ",594,30,0],[6038,15,"يَتِيمًۭا ذَا مَقْرَبَةٍ",594,30,0],[6039,16,"أَوْ مِسْكِينًۭا ذَا مَتْرَبَةٍۢ",594,30,0],[6040,17,"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",594,30,0],[6041,18,"أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْمَيْمَنَةِ",594,30,0],[6042,19,"وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا هُمْ أَصْحَٰبُ ٱلْمَشْـَٔمَةِ",594,30,0],[6043,20,"عَلَيْهِمْ نَارٌۭ مُّؤْصَدَةٌۢ",594,30,0]]