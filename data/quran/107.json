[[6198,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",602,30,0],[6199,2,"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",602,30,0],[6200,3,"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",602,30,0],[6201,4,"فَوَيْلٌۭ لِّلْمُصَلِّينَ",602,30,0],[6202,5,"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",602,30,0],[6203,6,"ٱلَّذِينَ هُمْ يُرَآءُونَ",602,30,0],[6204,7,"وَيَمْنَعُونَ ٱلْمَاعُونَ",602,30,0]]