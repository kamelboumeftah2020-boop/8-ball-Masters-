[[6044,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا",595,30,0],[6045,2,"وَٱلْقَمَرِ إِذَا تَلَىٰهَا",595,30,0],[6046,3,"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",595,30,0],[6047,4,"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",595,30,0],[6048,5,"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",595,30,0],[6049,6,"وَٱلْأَرْضِ وَمَا طَحَىٰهَا",595,30,0],[6050,7,"وَنَفْسٍۢ وَمَا سَوَّىٰهَا",595,30,0],[6051,8,"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",595,30,0],[6052,9,"قَدْ أَفْلَحَ مَن زَكَّىٰهَا",595,30,0],[6053,10,"وَقَدْ خَابَ مَن دَسَّىٰهَا",595,30,0],[6054,11,"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",595,30,0],[6055,12,"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",595,30,0],[6056,13,"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا",595,30,0],[6057,14,"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",595,30,0],[6058,15,"وَلَا يَخَافُ عُقْبَٰهَا",595,30,0]]