[[3789,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلصَّٰٓفَّٰتِ صَفًّۭا",446,23,0],[3790,2,"فَٱلزَّٰجِرَٰتِ زَجْرًۭا",446,23,0],[3791,3,"فَٱلتَّٰلِيَٰتِ ذِكْرًا",446,23,0],[3792,4,"إِنَّ إِلَٰهَكُمْ لَوَٰحِدٌۭ",446,23,0],[3793,5,"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ ٱلْمَشَٰرِقِ",446,23,0],[3794,6,"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِزِينَةٍ ٱلْكَوَاكِبِ",446,23,0],[3795,7,"وَحِفْظًۭا مِّن كُلِّ شَيْطَٰنٍۢ مَّارِدٍۢ",446,23,0],[3796,8,"لَّا يَسَّمَّعُونَ إِلَى ٱلْمَلَإِ ٱلْأَعْلَىٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبٍۢ",446,23,0],[3797,9,"دُحُورًۭا ۖ وَلَهُمْ عَذَابٌۭ وَاصِبٌ",446,23,0],[3798,10,"إِلَّا مَنْ خَطِفَ ٱلْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابٌۭ ثَاقِبٌۭ",446,23,0],[3799,11,"فَٱسْتَفْتِهِمْ أَهُمْ أَشَدُّ خَلْقًا أَم مَّنْ خَلَقْنَآ ۚ إِنَّا خَلَقْنَٰهُم مِّن طِينٍۢ لَّازِبٍۭ",446,23,0],[3800,12,"بَلْ عَجِبْتَ وَيَسْخَرُونَ",446,23,0],[3801,13,"وَإِذَا ذُكِّرُوا۟ لَا يَذْكُرُونَ",446,23,0],[3802,14,"وَإِذَا رَأَوْا۟ ءَايَةًۭ يَسْتَسْخِرُونَ",446,23,0],[3803,15,"وَقَالُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌۭ مُّبِينٌ",446,23,0],[3804,16,"أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ",446,23,0],[3805,17,"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",446,23,0],[3806,18,"قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَ",446,23,0],[3807,19,"فَإِنَّمَا هِىَ زَجْرَةٌۭ وَٰحِدَةٌۭ فَإِذَا هُمْ يَنظُرُونَ",446,23,0],[3808,20,"وَقَالُوا۟ يَٰوَيْلَنَا هَٰذَا يَوْمُ ٱلدِّينِ",446,23,0],[3809,21,"هَٰذَا يَوْمُ ٱلْفَصْلِ ٱلَّذِى كُنتُم بِهِۦ تُكَذِّبُونَ",446,23,0],[3810,22,"۞ ٱحْشُرُوا۟ ٱلَّذِينَ ظَلَمُوا۟ وَأَزْوَٰجَهُمْ وَمَا كَانُوا۟ يَعْبُدُونَ",446,23,0],[3811,23,"مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ",446,23,0],[3812,24,"وَقِفُوهُمْ ۖ إِنَّهُم مَّسْـُٔولُونَ",446,23,0],[3813,25,"مَا لَكُمْ لَا تَنَاصَرُونَ",447,23,0],[3814,26,"بَلْ هُمُ ٱلْيَوْمَ مُسْتَسْلِمُونَ",447,23,0],[3815,27,"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ",447,23,0],[3816,28,"قَالُوٓا۟ إِنَّكُمْ كُنتُمْ تَأْتُونَنَا عَنِ ٱلْيَمِينِ",447,23,0],[3817,29,"قَالُوا۟ بَل لَّمْ تَكُونُوا۟ مُؤْمِنِينَ",447,23,0],[3818,30,"وَمَا كَانَ لَنَا عَلَيْكُم مِّن سُلْطَٰنٍۭ ۖ بَلْ كُنتُمْ قَوْمًۭا طَٰغِينَ",447,23,0],[3819,31,"فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَآ ۖ إِنَّا لَذَآئِقُونَ",447,23,0],[3820,32,"فَأَغْوَيْنَٰكُمْ إِنَّا كُنَّا غَٰوِينَ",447,23,0],[3821,33,"فَإِنَّهُمْ يَوْمَئِذٍۢ فِى ٱلْعَذَابِ مُشْتَرِكُونَ",447,23,0],[3822,34,"إِنَّا كَذَٰلِكَ نَفْعَلُ بِٱلْمُجْرِمِينَ",447,23,0],[3823,35,"إِنَّهُمْ كَانُوٓا۟ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسْتَكْبِرُونَ",447,23,0],[3824,36,"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓا۟ ءَالِهَتِنَا لِشَاعِرٍۢ مَّجْنُونٍۭ",447,23,0],[3825,37,"بَلْ جَآءَ بِٱلْحَقِّ وَصَدَّقَ ٱلْمُرْسَلِينَ",447,23,0],[3826,38,"إِنَّكُمْ لَذَآئِقُوا۟ ٱلْعَذَابِ ٱلْأَلِيمِ",447,23,0],[3827,39,"وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ",447,23,0],[3828,40,"إِلَّا عِبَادَ ٱللَّهِ ٱلْمُخْلَصِينَ",447,23,0],[3829,41,"أُو۟لَٰٓئِكَ لَهُمْ رِزْقٌۭ مَّعْلُومٌۭ",447,23,0],[3830,42,"فَوَٰكِهُ ۖ وَهُم مُّكْرَمُونَ",447,23,0],[3831,43,"فِى جَنَّٰتِ ٱلنَّعِيمِ",447,23,0],[3832,44,"عَلَىٰ سُرُرٍۢ مُّتَقَٰبِلِينَ",447,23,0],[3833,45,"يُطَافُ عَلَيْهِم بِكَأْسٍۢ مِّن مَّعِينٍۭ",447,23,0],[3834,46,"بَيْضَآءَ لَذَّةٍۢ لِّلشَّٰرِبِينَ",447,23,0],[3835,47,"لَا فِيهَا غَوْلٌۭ وَلَا هُمْ عَنْهَا يُنزَفُونَ",447,23,0],[3836,48,"وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ عِينٌۭ",447,23,0],[3837,49,"كَأَنَّهُنَّ بَيْضٌۭ مَّكْنُونٌۭ",447,23,0],[3838,50,"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍۢ يَتَسَآءَلُونَ",447,23,0],[3839,51,"قَالَ قَآئِلٌۭ مِّنْهُمْ إِنِّى كَانَ لِى قَرِينٌۭ",447,23,0],[3840,52,"يَقُولُ أَءِنَّكَ لَمِنَ ٱلْمُصَدِّقِينَ",448,23,0],[3841,53,"أَءِذَا مِتْنَا وَكُنَّا تُرَابًۭا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ",448,23,0],[3842,54,"قَالَ هَلْ أَنتُم مُّطَّلِعُونَ",448,23,0],[3843,55,"فَٱطَّلَعَ فَرَءَاهُ فِى سَوَآءِ ٱلْجَحِيمِ",448,23,0],[3844,56,"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرْدِينِ",448,23,0],[3845,57,"وَلَوْلَا نِعْمَةُ رَبِّى لَكُنتُ مِنَ ٱلْمُحْضَرِينَ",448,23,0],[3846,58,"أَفَمَا نَحْنُ بِمَيِّتِينَ",448,23,0]