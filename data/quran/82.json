[[5830,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا ٱلسَّمَآءُ ٱنفَطَرَتْ",587,30,0],[5831,2,"وَإِذَا ٱلْكَوَاكِبُ ٱنتَثَرَتْ",587,30,0],[5832,3,"وَإِذَا ٱلْبِحَارُ فُجِّرَتْ",587,30,0],[5833,4,"وَإِذَا ٱلْقُبُورُ بُعْثِرَتْ",587,30,0],[5834,5,"عَلِمَتْ نَفْسٌۭ مَّا قَدَّمَتْ وَأَخَّرَتْ",587,30,0],[5835,6,"يَٰٓأَيُّهَا ٱلْإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلْكَرِيمِ",587,30,0],[5836,7,"ٱلَّذِى خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ",587,30,0],[5837,8,"فِىٓ أَىِّ صُورَةٍۢ مَّا شَآءَ رَكَّبَكَ",587,30,0],[5838,9,"كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ",587,30,0],[5839,10,"وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ",587,30,0],[5840,11,"كِرَامًۭا كَٰتِبِينَ",587,30,0],[5841,12,"يَعْلَمُونَ مَا تَفْعَلُونَ",587,30,0],[5842,13,"إِنَّ ٱلْأَبْرَارَ لَفِى نَعِيمٍۢ",587,30,0],[5843,14,"وَإِنَّ ٱلْفُجَّارَ لَفِى جَحِيمٍۢ",587,30,0],[5844,15,"يَصْلَوْنَهَا يَوْمَ ٱلدِّينِ",587,30,0],[5845,16,"وَمَا هُمْ عَنْهَا بِغَآئِبِينَ",587,30,0],[5846,17,"وَمَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",587,30,0],[5847,18,"ثُمَّ مَآ أَدْرَىٰكَ مَا يَوْمُ ٱلدِّينِ",587,30,0],[5848,19,"يَوْمَ لَا تَمْلِكُ نَفْسٌۭ لِّنَفْسٍۢ شَيْـًۭٔا ۖ وَٱلْأَمْرُ يَوْمَئِذٍۢ لِّلَّهِ",587,30,0]]