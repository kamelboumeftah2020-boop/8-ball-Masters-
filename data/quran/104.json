[[6180,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَيْلٌۭ لِّكُلِّ هُمَزَةٍۢ لُّمَزَةٍ",601,30,0],[6181,2,"ٱلَّذِى جَمَعَ مَالًۭا وَعَدَّدَهُۥ",601,30,0],[6182,3,"يَحْسَبُ أَنَّ مَالَهُۥٓ أَخْلَدَهُۥ",601,30,0],[6183,4,"كَلَّا ۖ لَيُنۢبَذَنَّ فِى ٱلْحُطَمَةِ",601,30,0],[6184,5,"وَمَآ أَدْرَىٰكَ مَا ٱلْحُطَمَةُ",601,30,0],[6185,6,"نَارُ ٱللَّهِ ٱلْمُوقَدَةُ",601,30,0],[6186,7,"ٱلَّتِى تَطَّلِعُ عَلَى ٱلْأَفْـِٔدَةِ",601,30,0],[6187,8,"إِنَّهَا عَلَيْهِم مُّؤْصَدَةٌۭ",601,30,0],[6188,9,"فِى عَمَدٍۢ مُّمَدَّدَةٍۭ",601,30,0]]