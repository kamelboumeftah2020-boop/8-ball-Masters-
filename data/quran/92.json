[[6059,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ",595,30,0],[6060,2,"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",595,30,0],[6061,3,"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",595,30,0],[6062,4,"إِنَّ سَعْيَكُمْ لَشَتَّىٰ",595,30,0],[6063,5,"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",595,30,0],[6064,6,"وَصَدَّقَ بِٱلْحُسْنَىٰ",595,30,0],[6065,7,"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",595,30,0],[6066,8,"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",595,30,0],[6067,9,"وَكَذَّبَ بِٱلْحُسْنَىٰ",595,30,0],[6068,10,"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",595,30,0],[6069,11,"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",595,30,0],[6070,12,"إِنَّ عَلَيْنَا لَلْهُدَىٰ",595,30,0],[6071,13,"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ",595,30,0],[6072,14,"فَأَنذَرْتُكُمْ نَارًۭا تَلَظَّىٰ",595,30,0],[6073,15,"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى",596,30,0],[6074,16,"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ",596,30,0],[6075,17,"وَسَيُجَنَّبُهَا ٱلْأَتْقَى",596,30,0],[6076,18,"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ",596,30,0],[6077,19,"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍۢ تُجْزَىٰٓ",596,30,0],[6078,20,"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ",596,30,0],[6079,21,"وَلَسَوْفَ يَرْضَىٰ",596,30,0]]