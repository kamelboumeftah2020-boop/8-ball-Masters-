[[6091,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ",596,30,0],[6092,2,"وَوَضَعْنَا عَنكَ وِزْرَكَ",596,30,0],[6093,3,"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ",596,30,0],[6094,4,"وَرَفَعْنَا لَكَ ذِكْرَكَ",596,30,0],[6095,5,"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا",596,30,0],[6096,6,"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًۭا",596,30,0],[6097,7,"فَإِذَا فَرَغْتَ فَٱنصَبْ",596,30,0],[6098,8,"وَإِلَىٰ رَبِّكَ فَٱرْغَب",596,30,0]]