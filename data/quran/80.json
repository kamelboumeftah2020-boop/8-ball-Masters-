[[5759,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ عَبَسَ وَتَوَلَّىٰٓ",585,30,0],[5760,2,"أَن جَآءَهُ ٱلْأَعْمَىٰ",585,30,0],[5761,3,"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ",585,30,0],[5762,4,"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ",585,30,0],[5763,5,"أَمَّا مَنِ ٱسْتَغْنَىٰ",585,30,0],[5764,6,"فَأَنتَ لَهُۥ تَصَدَّىٰ",585,30,0],[5765,7,"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ",585,30,0],[5766,8,"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ",585,30,0],[5767,9,"وَهُوَ يَخْشَىٰ",585,30,0],[5768,10,"فَأَنتَ عَنْهُ تَلَهَّىٰ",585,30,0],[5769,11,"كَلَّآ إِنَّهَا تَذْكِرَةٌۭ",585,30,0],[5770,12,"فَمَن شَآءَ ذَكَرَهُۥ",585,30,0],[5771,13,"فِى صُحُفٍۢ مُّكَرَّمَةٍۢ",585,30,0],[5772,14,"مَّرْفُوعَةٍۢ مُّطَهَّرَةٍۭ",585,30,0],[5773,15,"بِأَيْدِى سَفَرَةٍۢ",585,30,0],[5774,16,"كِرَامٍۭ بَرَرَةٍۢ",585,30,0],[5775,17,"قُتِلَ ٱلْإِنسَٰنُ مَآ أَكْفَرَهُۥ",585,30,0],[5776,18,"مِنْ أَىِّ شَىْءٍ خَلَقَهُۥ",585,30,0],[5777,19,"مِن نُّطْفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ",585,30,0],[5778,20,"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ",585,30,0],[5779,21,"ثُمَّ أَمَاتَهُۥ فَأَقْبَرَهُۥ",585,30,0],[5780,22,"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ",585,30,0],[5781,23,"كَلَّا لَمَّا يَقْضِ مَآ أَمَرَهُۥ",585,30,0],[5782,24,"فَلْيَنظُرِ ٱلْإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ",585,30,0],[5783,25,"أَنَّا صَبَبْنَا ٱلْمَآءَ صَبًّۭا",585,30,0],[5784,26,"ثُمَّ شَقَقْنَا ٱلْأَرْضَ شَقًّۭا",585,30,0],[5785,27,"فَأَنۢبَتْنَا فِيهَا حَبًّۭا",585,30,0],[5786,28,"وَعِنَبًۭا وَقَضْبًۭا",585,30,0],[5787,29,"وَزَيْتُونًۭا وَنَخْلًۭا",585,30,0],[5788,30,"وَحَدَآئِقَ غُلْبًۭا",585,30,0],[5789,31,"وَفَٰكِهَةًۭ وَأَبًّۭا",585,30,0],[5790,32,"مَّتَٰعًۭا لَّكُمْ وَلِأَنْعَٰمِكُمْ",585,30,0],[5791,33,"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ",585,30,0],[5792,34,"يَوْمَ يَفِرُّ ٱلْمَرْءُ مِنْ أَخِيهِ",585,30,0],[5793,35,"وَأُمِّهِۦ وَأَبِيهِ",585,30,0],[5794,36,"وَصَٰحِبَتِهِۦ وَبَنِيهِ",585,30,0],[5795,37,"لِكُلِّ ٱمْرِئٍۢ مِّنْهُمْ يَوْمَئِذٍۢ شَأْنٌۭ يُغْنِيهِ",585,30,0],[5796,38,"وُجُوهٌۭ يَوْمَئِذٍۢ مُّسْفِرَةٌۭ",585,30,0],[5797,39,"ضَاحِكَةٌۭ مُّسْتَبْشِرَةٌۭ",585,30,0],[5798,40,"وَوُجُوهٌۭ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۭ",585,30,0],[5799,41,"تَرْهَقُهَا قَتَرَةٌ",585,30,0],[5800,42,"أُو۟لَٰٓئِكَ هُمُ ٱلْكَفَرَةُ ٱلْفَجَرَةُ",585,30,0]]