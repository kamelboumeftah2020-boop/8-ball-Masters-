[[6208,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ قُلْ يَٰٓأَيُّهَا ٱلْكَٰفِرُونَ",603,30,0],[6209,2,"لَآ أَعْبُدُ مَا تَعْبُدُونَ",603,30,0],[6210,3,"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ",603,30,0],[6211,4,"وَلَآ أَنَا۠ عَابِدٌۭ مَّا عَبَدتُّمْ",603,30,0],[6212,5,"وَلَآ أَنتُمْ عَٰبِدُونَ مَآ أَعْبُدُ",603,30,0],[6213,6,"لَكُمْ دِينُكُمْ وَلِىَ دِينِ",603,30,0]]