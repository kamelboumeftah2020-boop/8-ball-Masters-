[[6107,1,"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ",597,30,0],[6108,2,"خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ",597,30,0],[6109,3,"ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ",597,30,0],[6110,4,"ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ",597,30,0],[6111,5,"عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ",597,30,0],[6112,6,"كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ",597,30,0],[6113,7,"أَن رَّءَاهُ ٱسْتَغْنَىٰٓ",597,30,0],[6114,8,"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ",597,30,0],[6115,9,"أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ",597,30,0],[6116,10,"عَبْدًا إِذَا صَلَّىٰٓ",597,30,0],[6117,11,"أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ",597,30,0],[6118,12,"أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ",597,30,0],[6119,13,"أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ",597,30,0],[6120,14,"أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ",597,30,0],[6121,15,"كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ",597,30,0],[6122,16,"نَاصِيَةٍۢ كَٰذِبَةٍ خَاطِئَةٍۢ",597,30,0],[6123,17,"فَلْيَدْعُ نَادِيَهُۥ",597,30,0],[6124,18,"سَنَدْعُ ٱلزَّبَانِيَةَ",597,30,0],[6125,19,"كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب ۩",597,30,1]]