    <item>
        <shape android:shape="oval">
            <gradient android:angle="315" android:startColor="#16A57F" android:endColor="#08503E" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
