{
  "name": "football-legends-5v5",
  "version": "1.0.0",
  "description": "لعبة كرة قدم أونلاين 5 ضد 5 بشخصيات ذات قدرات خاصة",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:offline": "node scripts/build-offline.mjs",
    "build:app": "node scripts/build-app.mjs",
    "apk": "node scripts/build-app.mjs && npx cap sync android && cd android && ./gradlew assembleRelease"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "esbuild": "^0.25.12",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  }
}
